<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:union="https://github.com/avaunion"
             x:Class="AvaUnion.Gallery.Pages.ButtonsPage">
  <StackPanel Spacing="16">
    <Label Content="Buttons" FontWeight="Bold" />
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button Content="Button" />
      <Button Content="Default" IsDefault="True" />
      <Button Content="Flat" Classes="flat" />
      <Button Content="Disabled" IsEnabled="False" />
      <Button Content="With menu">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="First" />
            <MenuItem Header="Second" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <RepeatButton Content="Repeat" />
      <ToggleButton Content="Toggle" />
      <ToggleButton Content="Checked" IsChecked="True" />
      <HyperlinkButton Content="A hyperlink" />
    </WrapPanel>
    <Label Content="Split and drop-down buttons" FontWeight="Bold" />
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <SplitButton Content="Split">
        <SplitButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="First" />
            <MenuItem Header="Second" />
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>
      <ToggleSplitButton Content="Toggle split" IsChecked="True">
        <ToggleSplitButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="Option" />
          </MenuFlyout>
        </ToggleSplitButton.Flyout>
      </ToggleSplitButton>
      <DropDownButton Content="Drop down">
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="One" />
            <MenuItem Header="Two" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </WrapPanel>
    <Label Content="Icons" FontWeight="Bold" />
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <union:UnionIcon IconName="document-save" Width="16" Height="16" />
          <TextBlock Text="Text and icon" />
        </StackPanel>
      </Button>
      <Button>
        <StackPanel>
          <union:UnionIcon IconName="document-save" Width="16" Height="16" />
          <TextBlock Text="Text under icon" />
        </StackPanel>
      </Button>
      <Button>
        <union:UnionIcon IconName="document-save" Width="16" Height="16" />
      </Button>
      <Button IsEnabled="False">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <union:UnionIcon IconName="document-save" Width="16" Height="16" />
          <TextBlock Text="Disabled" />
        </StackPanel>
      </Button>
      <Button Classes="flat">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <union:UnionIcon IconName="document-save" Width="16" Height="16" />
          <TextBlock Text="Flat" />
        </StackPanel>
      </Button>
      <ToggleButton IsChecked="True">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <union:UnionIcon IconName="document-save" Width="16" Height="16" />
          <TextBlock Text="Checked" />
        </StackPanel>
      </ToggleButton>
    </WrapPanel>
    <Label Content="Tool buttons" FontWeight="Bold" />
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button union:Union.Type="toolbutton" Content="Text" />
      <Button union:Union.Type="toolbutton">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <union:UnionIcon IconName="document-save" Width="16" Height="16" />
          <TextBlock Text="Text and icon" />
        </StackPanel>
      </Button>
      <Button union:Union.Type="toolbutton">
        <StackPanel>
          <union:UnionIcon IconName="document-save" Width="16" Height="16" />
          <TextBlock Text="Text under icon" />
        </StackPanel>
      </Button>
      <Button union:Union.Type="toolbutton">
        <union:UnionIcon IconName="document-save" Width="16" Height="16" />
      </Button>
      <ToggleButton union:Union.Type="toolbutton" IsChecked="True">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <union:UnionIcon IconName="document-save" Width="16" Height="16" />
          <TextBlock Text="Checked" />
        </StackPanel>
      </ToggleButton>
      <Button union:Union.Type="toolbutton" Content="Disabled" IsEnabled="False" />
    </WrapPanel>
    <Label Content="Round buttons" FontWeight="Bold" />
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button union:Union.Type="roundbutton">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <union:UnionIcon IconName="document-save" Width="16" Height="16" />
          <TextBlock Text="Round" />
        </StackPanel>
      </Button>
      <Button union:Union.Type="roundbutton">
        <union:UnionIcon IconName="list-add" Width="16" Height="16" />
      </Button>
      <Button union:Union.Type="roundbutton" Content="Disabled" IsEnabled="False" />
    </WrapPanel>
  </StackPanel>
</UserControl>
