<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaUnion.Gallery.Pages.MenusPage">
  <StackPanel Spacing="12">
    <Label Content="Menu bar" FontWeight="Bold" />
    <Menu>
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGesture="Ctrl+N" />
        <MenuItem Header="_Open…" InputGesture="Ctrl+O" />
        <Separator />
        <MenuItem Header="Recent">
          <MenuItem Header="report.odt" />
          <MenuItem Header="notes.txt" />
        </MenuItem>
        <Separator />
        <MenuItem Header="_Quit" InputGesture="Ctrl+Q" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Show toolbar" ToggleType="CheckBox" IsChecked="True" />
        <MenuItem Header="Show status bar" ToggleType="CheckBox" />
        <Separator />
        <MenuItem Header="Small icons" ToggleType="Radio" GroupName="size" />
        <MenuItem Header="Large icons" ToggleType="Radio" GroupName="size" IsChecked="True" />
      </MenuItem>
      <MenuItem Header="_Help" />
    </Menu>
    <Label Content="Context menu and tool tip" FontWeight="Bold" />
    <Border Width="300" Height="80" HorizontalAlignment="Left"
            Background="{DynamicResource Union.Active.View.Background.NormalBrush}"
            BorderBrush="{DynamicResource Union.Active.View.Decoration.FrameBrush}"
            BorderThickness="1" CornerRadius="5"
            ToolTip.Tip="Right-click for a context menu">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Cut" InputGesture="Ctrl+X" />
          <MenuItem Header="Copy" InputGesture="Ctrl+C" />
          <MenuItem Header="Paste" InputGesture="Ctrl+V" IsEnabled="False" />
        </ContextMenu>
      </Border.ContextMenu>
      <TextBlock Text="Right-click here" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </StackPanel>
</UserControl>
