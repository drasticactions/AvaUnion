<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaUnion.Gallery.Pages.PickersPage">
  <StackPanel Spacing="16">
    <Label Content="Date and time pickers" FontWeight="Bold" />
    <DatePicker />
    <TimePicker />
    <CalendarDatePicker Width="220" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
