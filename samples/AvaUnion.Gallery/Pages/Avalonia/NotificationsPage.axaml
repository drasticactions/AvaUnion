<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaUnion.Gallery.Pages.NotificationsPage">
  <StackPanel Spacing="16">
    <Label Content="Inline messages" FontWeight="Bold" />
    <NotificationCard NotificationType="Information" Content="Information: the backup finished." HorizontalAlignment="Left" />
    <NotificationCard NotificationType="Success" Content="Saved to Documents." HorizontalAlignment="Left" />
    <NotificationCard NotificationType="Warning" Content="The disk is almost full." HorizontalAlignment="Left" />
    <NotificationCard NotificationType="Error" Content="The file could not be opened." HorizontalAlignment="Left" />
    <Button Name="ShowToast" Content="Show a notification" HorizontalAlignment="Left" />
    <Label Content="Command bar" FontWeight="Bold" />
    <CommandBar>
      <CommandBar.PrimaryCommands>
        <CommandBarButton Label="New" />
        <CommandBarButton Label="Open" />
        <CommandBarSeparator />
        <CommandBarToggleButton Label="Bold" IsChecked="True" />
      </CommandBar.PrimaryCommands>
      <CommandBar.SecondaryCommands>
        <CommandBarButton Label="Settings" />
      </CommandBar.SecondaryCommands>
    </CommandBar>
    <Label Content="Auto-complete, pages and splitters" FontWeight="Bold" />
    <AutoCompleteBox Name="Complete" Width="220" HorizontalAlignment="Left" PlaceholderText="A state" />
    <PipsPager NumberOfPages="5" SelectedPageIndex="1" />
    <Grid ColumnDefinitions="120,Auto,120" Height="60" HorizontalAlignment="Left">
      <Border Background="{DynamicResource Union.Active.View.Background.NormalBrush}" />
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <Border Grid.Column="2" Background="{DynamicResource Union.Active.View.Background.NormalBrush}" />
    </Grid>
    <SelectableTextBlock Text="Selectable text: drag over it to select." />
  </StackPanel>
</UserControl>
