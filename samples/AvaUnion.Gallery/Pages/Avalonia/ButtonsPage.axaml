<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaUnion.Gallery.Pages.ButtonsPage">
  <StackPanel Spacing="16">
    <Label Content="Buttons" FontWeight="Bold" />
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button Content="Button" />
      <Button Content="Default" IsDefault="True" />
      <Button Content="Flat" Classes="flat" />
      <Button Content="Disabled" IsEnabled="False" />
      <Button Content="With menu">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="First" />
            <MenuItem Header="Second" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <RepeatButton Content="Repeat" />
      <ToggleButton Content="Toggle" />
      <ToggleButton Content="Checked" IsChecked="True" />
      <HyperlinkButton Content="A hyperlink" />
    </WrapPanel>
    <Label Content="Split and drop-down buttons" FontWeight="Bold" />
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <SplitButton Content="Split">
        <SplitButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="First" />
            <MenuItem Header="Second" />
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>
      <ToggleSplitButton Content="Toggle split" IsChecked="True">
        <ToggleSplitButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="Option" />
          </MenuFlyout>
        </ToggleSplitButton.Flyout>
      </ToggleSplitButton>
      <DropDownButton Content="Drop down">
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="One" />
            <MenuItem Header="Two" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </WrapPanel>
  </StackPanel>
</UserControl>
