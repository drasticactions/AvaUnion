<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaUnion.Gallery.Pages.QmlTreeViewPage">
  <StackPanel Spacing="5" HorizontalAlignment="Left">
    <CheckBox Name="Enabled" Content="Treeview enabled" IsChecked="True" />
    <TreeView Name="Tree" Width="420" IsEnabled="{Binding #Enabled.IsChecked}" />
  </StackPanel>
</UserControl>
