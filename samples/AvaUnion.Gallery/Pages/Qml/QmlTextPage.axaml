<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:union="https://github.com/avaunion"
             x:Class="AvaUnion.Gallery.Pages.QmlTextPage">
  <StackPanel Spacing="5" HorizontalAlignment="Left">
    <Label Content="Label" />
    <Label Content="Disabled Label" IsEnabled="False" />
    <union:Heading Content="Heading" />
    <union:Heading Content="Disabled Heading" IsEnabled="False" />
    <TextBox PlaceholderText="Text Field" Width="200" HorizontalAlignment="Left" />
    <TextBox PlaceholderText="Disabled Text Field" Width="200" HorizontalAlignment="Left" IsEnabled="False" />
    <union:ActionTextField Name="Password" PlaceholderText="Password field" PasswordChar="●" Width="200" HorizontalAlignment="Left">
      <union:ActionTextField.RightActions>
        <union:TextFieldAction IconName="password-show-on" Text="Show Password" />
      </union:ActionTextField.RightActions>
    </union:ActionTextField>
    <union:ActionTextField Name="Actions" PlaceholderText="ActionTextField" Height="40">
      <union:ActionTextField.RightActions>
        <union:TextFieldAction IconName="edit-delete-remove" Text="Cancel" />
        <union:TextFieldAction IconName="checkmark" Text="Confirm" IsVisible="False" />
      </union:ActionTextField.RightActions>
    </union:ActionTextField>
    <TextBox AcceptsReturn="True" PlaceholderText="Text Area" Width="200" HorizontalAlignment="Left" />
    <TextBox AcceptsReturn="True" PlaceholderText="Disabled Text Area" Width="200" HorizontalAlignment="Left" IsEnabled="False" />
    <NumericUpDown Minimum="0" Maximum="1000" Increment="1" Value="0" HorizontalAlignment="Left" />
    <NumericUpDown Minimum="0" Maximum="1000" Increment="1" Value="0" HorizontalAlignment="Left" IsEnabled="False" />
    <NumericUpDown Minimum="10" Maximum="1000" Increment="10" Value="10" Width="50" HorizontalAlignment="Left" />
    <TextBox union:Union.Type="searchfield" Width="200" HorizontalAlignment="Left">
      <TextBox.InnerLeftContent>
        <union:UnionIcon union:Union.Type="searchindicator" />
      </TextBox.InnerLeftContent>
    </TextBox>
  </StackPanel>
</UserControl>
