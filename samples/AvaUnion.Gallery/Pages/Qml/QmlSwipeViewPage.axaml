<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaUnion.Gallery.Pages.QmlSwipeViewPage">
  <Panel MinHeight="400">
    <Carousel Name="View">
      <Panel><Label Content="Page 1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Panel>
      <Panel><Label Content="Page 2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Panel>
      <Panel><Label Content="Page 3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Panel>
    </Carousel>
    <PipsPager NumberOfPages="3" SelectedPageIndex="{Binding #View.SelectedIndex, Mode=TwoWay}"
               HorizontalAlignment="Center" VerticalAlignment="Bottom" />
  </Panel>
</UserControl>
