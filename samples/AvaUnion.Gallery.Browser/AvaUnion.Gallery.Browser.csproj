<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RootNamespace>AvaUnion.Gallery.Browser</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);IL2026;IL2045;IL2072;IL2075;IL2121;IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf;Assets\Fonts\*.otf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaUnion.Gallery\AvaUnion.Gallery.csproj" />
  </ItemGroup>

</Project>
