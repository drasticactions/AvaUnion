<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <Authors>drasticactions</Authors>
    <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/drasticactions/avaunion</PackageProjectUrl>
    <RepositoryUrl>https://github.com/drasticactions/avaunion</RepositoryUrl>
    <PackageTags>avalonia;theme;kde;plasma;union;breeze;linux</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaUnionRepoRoot>$(MSBuildThisFileDirectory)</AvaUnionRepoRoot>
    <AvaUnionUnionVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(AvaUnionRepoRoot)external/union/CMakeLists.txt')), 'set\(PROJECT_VERSION "([0-9.]+)"\)').Groups[1].Value)</AvaUnionUnionVersion>
    <AvaUnionRevision>0</AvaUnionRevision>
    <Version>$(AvaUnionUnionVersion).$(AvaUnionRevision)</Version>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(AvaUnionRepoRoot)Key.snk</AssemblyOriginatorKeyFile>
    <PublicKey></PublicKey>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AvaUnionIsLibrary)' != 'false'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(AvaUnionIsLibrary)' != 'false'">
    <None Include="$(AvaUnionRepoRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(AvaUnionRepoRoot)NOTICE.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(AvaUnionRepoRoot)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
