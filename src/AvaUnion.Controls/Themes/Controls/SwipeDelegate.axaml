<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    xmlns:primitives="using:AvaUnion.Controls.Primitives"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type union:SwipeDelegate}" TargetType="union:SwipeDelegate">
    <Setter Property="union:Union.Type" Value="swipedelegate" />
    <Setter Property="Padding" Value="{union:Style Layout.Padding}" />
    <Setter Property="Foreground" Value="{union:Style Text.Color}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <primitives:SwipePanel Position="{TemplateBinding SwipePosition}" Front="{Binding #PART_Front}">
          <ContentPresenter Name="PART_LeftContent"
                            Content="{TemplateBinding LeftContent}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
          <ContentPresenter Name="PART_RightContent"
                            Content="{TemplateBinding RightContent}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
          <Panel Name="PART_Front" Background="Transparent">
            <union:UnionBox ImplicitSize="True" Margin="{union:Style Layout.Inset}" />
            <union:UnionPositioner>
              <union:UnionIcon union:PositionedItem.Source="Icon" />
              <ContentPresenter Name="PART_ContentPresenter"
                                union:PositionedItem.Source="Text"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True"
                                TextWrapping="{union:Style Text.WrapMode, Fallback=NoWrap}"
                                VerticalContentAlignment="Center" />
            </union:UnionPositioner>
          </Panel>
        </primitives:SwipePanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ ContentPresenter#PART_LeftContent, ^ /template/ ContentPresenter#PART_RightContent">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:reveal-left /template/ ContentPresenter#PART_LeftContent">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:reveal-right /template/ ContentPresenter#PART_RightContent">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
