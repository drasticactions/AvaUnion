<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    xmlns:primitives="using:AvaUnion.Controls.Primitives"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type union:Dial}" TargetType="union:Dial">
    <Setter Property="union:Union.Type" Value="dial" />
    <Setter Property="Padding" Value="{union:Style Layout.Padding}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <primitives:DialPanel Background="Transparent"
                              Margin="{TemplateBinding Padding}"
                              MinWidth="{union:Style Layout.Width, Fallback=0}"
                              MinHeight="{union:Style Layout.Height, Fallback=0}"
                              Angle="{TemplateBinding Angle}"
                              BackgroundBox="{Binding #PART_Background}"
                              Handle="{Binding #PART_Handle}">
          <union:UnionBox Name="PART_Background" />
          <union:UnionBox Name="PART_Handle" union:Union.Type="handle" union:Union.StateSource="TemplatedParent" />
        </primitives:DialPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled /template/ union|UnionBox#PART_Background">
      <Setter Property="Opacity" Value="0.3" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
