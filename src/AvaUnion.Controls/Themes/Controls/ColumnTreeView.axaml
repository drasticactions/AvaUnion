<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    xmlns:primitives="using:AvaUnion.Controls.Primitives"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type union:ColumnTreeViewHeader}" TargetType="union:ColumnTreeViewHeader">
    <Setter Property="union:Union.Type" Value="headerviewdelegate" />
    <Setter Property="union:Union.Hints" Value="horizontal" />
    <Setter Property="Padding" Value="{union:Style Layout.Padding}" />
    <Setter Property="Foreground" Value="{union:Style Text.Color}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <union:UnionBox ImplicitSize="True" Margin="{union:Style Layout.Inset}" />
          <union:UnionPositioner>
            <ContentPresenter Name="PART_ContentPresenter"
                              union:PositionedItem.Source="Text"
                              Content="{TemplateBinding Content}"
                              TextTrimming="{union:Style Text.Elide, Fallback=CharacterEllipsis}"
                              VerticalContentAlignment="Center" />
          </union:UnionPositioner>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type union:ColumnTreeViewRow}" TargetType="union:ColumnTreeViewRow">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="union:Union.Type" Value="treeviewdelegate" />
    <Setter Property="Padding" Value="{union:Style Layout.Padding}" />
    <Setter Property="Foreground" Value="{union:Style Text.Color}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <union:UnionBox ImplicitSize="True" Margin="{union:Style Layout.Inset}" />
          <Grid Name="PART_Cells" Margin="{TemplateBinding Padding}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type union:ColumnTreeView}" TargetType="union:ColumnTreeView">
    <Setter Property="union:Union.Type" Value="scrollview" />
    <Setter Property="union:Union.ColorSet" Value="View" />
    <Setter Property="Foreground" Value="{union:SchemeColor View, Foreground, Text}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Grid.IsSharedSizeScope="True">
          <union:UnionBox Margin="{union:Style Layout.Inset}" />
          <union:UnionClip Margin="{union:Style Border}">
            <DockPanel>
              <Border DockPanel.Dock="Top"
                      union:Union.Type="headerview"
                      union:Union.Hints="horizontal"
                      union:Union.StateSource="None"
                      IsVisible="{TemplateBinding IsHeaderVisible}">
                <Panel>
                  <union:UnionBox Margin="{union:Style Layout.Inset}" />
                  <Grid Name="PART_Header" />
                </Panel>
              </Border>
              <ScrollViewer Theme="{DynamicResource UnionPlainScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <primitives:ColumnTreeRows Name="PART_Rows" Margin="{TemplateBinding Padding}">
                  <primitives:ColumnTreeRows.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </primitives:ColumnTreeRows.ItemsPanel>
                </primitives:ColumnTreeRows>
              </ScrollViewer>
            </DockPanel>
          </union:UnionClip>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
