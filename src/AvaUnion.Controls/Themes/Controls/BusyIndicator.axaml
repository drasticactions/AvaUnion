<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type union:BusyIndicator}" TargetType="union:BusyIndicator">
    <Setter Property="union:Union.Type" Value="busyindicator" />
    <Setter Property="Padding" Value="{union:Style Layout.Padding}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <union:UnionBox Margin="{union:Style Layout.Inset}" />
          <Panel Margin="{TemplateBinding Padding}"
                 MinWidth="{union:Style Layout.Width, Fallback=0}"
                 MinHeight="{union:Style Layout.Height, Fallback=0}">
            <union:UnionIcon Name="PART_Icon"
                             Width="{union:Style Layout.Width, Fallback=16}"
                             Height="{union:Style Layout.Height, Fallback=16}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Opacity="0"
                             RenderTransformOrigin="50%,50%">
              <union:UnionIcon.RenderTransform>
                <RotateTransform />
              </union:UnionIcon.RenderTransform>
            </union:UnionIcon>
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsRunning=True] /template/ union|UnionIcon#PART_Icon">
      <Setter Property="Opacity" Value="1" />
      <Style.Animations>
        <Animation Duration="0:0:2" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
