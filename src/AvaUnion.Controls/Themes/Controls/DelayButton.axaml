<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    xmlns:primitives="using:AvaUnion.Controls.Primitives"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type union:DelayButton}" TargetType="union:DelayButton">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="union:Union.Type" Value="delaybutton" />
    <Setter Property="Padding" Value="{union:Style Layout.Padding}" />
    <Setter Property="Foreground" Value="{union:Style Text.Color}" />
    <Setter Property="FontWeight" Value="{union:Style Text.Font, Fallback=Normal}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <union:UnionBox Margin="{union:Style Layout.Inset}" />
          <primitives:ProgressFillPanel Margin="{union:Style Layout.Inset}" Progress="{TemplateBinding Progress}">
            <union:UnionBox union:Union.Type="fill" union:Union.StateSource="None" />
          </primitives:ProgressFillPanel>
          <union:UnionPositioner>
            <union:UnionIcon union:PositionedItem.Source="Icon" />
            <ContentPresenter Name="PART_ContentPresenter"
                              union:PositionedItem.Source="Text"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              TextWrapping="NoWrap"
                              TextTrimming="{union:Style Text.Elide, Fallback=CharacterEllipsis}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
            <union:UnionIcon union:Union.Type="indicator"
                             union:PositionedItem.Source="Layout"
                             IsVisible="{union:Style Display.Visible, Fallback=False}" />
          </union:UnionPositioner>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
