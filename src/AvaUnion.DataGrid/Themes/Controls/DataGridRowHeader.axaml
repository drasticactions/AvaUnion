<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type DataGridRowHeader}" TargetType="DataGridRowHeader">
    <Setter Property="union:Union.Type" Value="headerviewdelegate" />
    <Setter Property="union:Union.Hints" Value="vertical" />
    <Setter Property="Foreground" Value="{union:Style Text.Color}" />
    <Setter Property="AreSeparatorsVisible" Value="False" />
    <Setter Property="MinWidth" Value="{union:Style Layout.Height, Fallback=32}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Root">
          <union:UnionBox Margin="{union:Style Layout.Inset}" />
          <ContentPresenter Margin="{union:Style Layout.Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
