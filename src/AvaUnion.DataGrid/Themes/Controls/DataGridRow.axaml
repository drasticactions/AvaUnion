<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type DataGridRow}" TargetType="DataGridRow">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="union:Union.Type" Value="tableviewdelegate" />
    <Setter Property="Foreground" Value="{union:Style Text.Color}" />
    <Setter Property="MinHeight" Value="{union:Style Layout.Height, Fallback=24}" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataGridFrozenGrid Name="PART_Root" ColumnDefinitions="Auto,*" RowDefinitions="*,Auto,Auto">
          <union:UnionBox Name="BackgroundRectangle" Grid.Column="1" Grid.RowSpan="2" Margin="{union:Style Layout.Inset}" />
          <DataGridRowHeader Name="PART_RowHeader" Grid.RowSpan="3" DataGridFrozenGrid.IsFrozen="True" />
          <DataGridCellsPresenter Name="PART_CellsPresenter" Grid.Column="1" DataGridFrozenGrid.IsFrozen="True" />
          <DataGridDetailsPresenter Name="PART_DetailsPresenter" Grid.Row="1" Grid.Column="1" />
          <Rectangle Name="PART_BottomGridLine" Grid.Row="2" Grid.Column="1" Height="1" HorizontalAlignment="Stretch" />
        </DataGridFrozenGrid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:invalid /template/ union|UnionBox#BackgroundRectangle">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
