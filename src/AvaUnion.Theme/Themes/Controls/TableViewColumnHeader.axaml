<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="UnionColumnResizer" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Rectangle Width="1" HorizontalAlignment="Center" Fill="{DynamicResource Union.Active.Header.Decoration.FrameBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TableViewColumnHeader}" TargetType="TableViewColumnHeader">
    <Setter Property="union:Union.Type" Value="headerviewdelegate" />
    <Setter Property="union:Union.Hints" Value="horizontal" />
    <Setter Property="Padding" Value="{union:Style Layout.Padding}" />
    <Setter Property="Foreground" Value="{union:Style Text.Color}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <union:UnionBox ImplicitSize="True" Margin="{union:Style Layout.Inset}" />
          <union:UnionPositioner>
            <union:UnionIcon union:PositionedItem.Source="Icon" />
            <ContentPresenter Name="PART_ContentPresenter"
                              union:PositionedItem.Source="Text"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              TextTrimming="{union:Style Text.Elide, Fallback=CharacterEllipsis}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="Center" />
          </union:UnionPositioner>
          <Thumb Name="PART_Resizer"
                 Theme="{StaticResource UnionColumnResizer}"
                 Width="7"
                 HorizontalAlignment="Right"
                 Cursor="SizeWestEast"
                 IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Column?.CanUserEffectivelyResize, FallbackValue=False}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
