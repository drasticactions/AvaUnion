<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
    <Setter Property="union:Union.Type" Value="menubar" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource UnionMenuBarItem}" />
    <Setter Property="Padding" Value="{union:Style Layout.Padding}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <union:UnionBox Margin="{union:Style Layout.Inset}" />
          <ItemsPresenter Name="PART_ItemsPresenter"
                          Margin="{TemplateBinding Padding}"
                          ItemsPanel="{TemplateBinding ItemsPanel}"
                          VerticalAlignment="Stretch"
                          KeyboardNavigation.TabNavigation="Continue" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
