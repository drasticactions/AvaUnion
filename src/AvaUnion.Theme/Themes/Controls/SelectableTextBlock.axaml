<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="{union:SchemeColor Selection, Background, Normal}" />
    <Setter Property="SelectionForegroundBrush" Value="{union:SchemeColor Selection, Foreground, Text}" />
    <Style Selector="^[IsEnabled=True]">
      <Setter Property="Cursor" Value="IBeam" />
      <Setter Property="ContextFlyout">
        <MenuFlyout>
          <MenuItem Header="{DynamicResource StringTextFlyoutCopyText}"
                    Command="{Binding $parent[SelectableTextBlock].Copy}"
                    IsEnabled="{Binding $parent[SelectableTextBlock].CanCopy}"
                    InputGesture="{x:Static TextBox.CopyGesture}" />
        </MenuFlyout>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
