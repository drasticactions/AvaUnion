<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
    <Setter Property="union:Union.Type" Value="progressbar" />
    <Setter Property="Padding" Value="{union:Style Layout.Padding}" />
    <Setter Property="Foreground" Value="{union:SchemeColor Window, Foreground, Text}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ProgressBar">
        <Panel>
          <union:UnionBox ImplicitSize="True" Margin="{union:Style Layout.Inset}" />
          <Panel Name="PART_Content" Margin="{TemplateBinding Padding}">
            <Border Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Stretch">
              <union:UnionBox union:Union.Type="track" union:Union.StateSource="None" />
            </Border>
            <union:IndeterminateTrackPanel Name="PART_Indeterminate" IsVisible="False" Orientation="{TemplateBinding Orientation}">
              <union:UnionBox union:Union.Type="track" union:Union.StateSource="None" />
            </union:IndeterminateTrackPanel>
          </Panel>
          <Panel Margin="{union:Style Layout.Padding.Left, Sides=Left}">
            <TextBlock Name="PART_Text"
                       Margin="{union:Style Layout.Padding.Right, Sides=Right}"
                       IsVisible="{TemplateBinding ShowProgressText}"
                       HorizontalAlignment="{union:Style Text.Alignment.Horizontal, Fallback=Center}"
                       VerticalAlignment="{union:Style Text.Alignment.Vertical, Fallback=Center}"
                       Text="{Binding $parent[ProgressBar].Percentage, StringFormat={}{0:0}%}" />
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:vertical /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="^:vertical /template/ TextBlock#PART_Text">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:indeterminate /template/ TextBlock#PART_Text">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:indeterminate /template/ union|IndeterminateTrackPanel#PART_Indeterminate">
      <Setter Property="IsVisible" Value="True" />
      <Style.Animations>
        <Animation Duration="0:0:2" IterationCount="Infinite" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Position" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Position" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Position" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
