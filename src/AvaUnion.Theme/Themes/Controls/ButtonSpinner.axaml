<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner" BasedOn="{StaticResource UnionInnerButtonSpinner}">
    <Setter Property="union:Union.Type" Value="spinbox" />
    <Setter Property="Foreground" Value="{union:Style Text.Color, FallbackColor=View.Foreground.Text}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <union:UnionBox ImplicitSize="True" Margin="{union:Style Layout.Inset}" />
          <union:UnionPositioner>
            <RepeatButton Name="PART_DecreaseButton"
                          Theme="{StaticResource UnionIndicatorButton}"
                          union:Union.Hints="decrease"
                          union:PositionedItem.Source="Layout"
                          IsVisible="{TemplateBinding ShowButtonSpinner}" />
            <ContentPresenter Name="PART_ContentPresenter"
                              union:PositionedItem.Source="Layout"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" />
            <RepeatButton Name="PART_IncreaseButton"
                          Theme="{StaticResource UnionIndicatorButton}"
                          union:Union.Hints="increase"
                          union:PositionedItem.Source="Layout"
                          IsVisible="{TemplateBinding ShowButtonSpinner}" />
          </union:UnionPositioner>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
