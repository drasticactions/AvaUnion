<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type TimePicker}" TargetType="TimePicker">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="union:Union.Type" Value="combobox" />
    <Setter Property="Foreground" Value="{union:Style Text.Color}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="242" />
    <Setter Property="MaxWidth" Value="456" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid Name="LayoutRoot">
            <union:UnionBox ImplicitSize="True" Margin="{union:Style Layout.Inset}" />
            <Button Name="PART_FlyoutButton"
                    Theme="{StaticResource UnionPickerFace}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    TemplatedControl.IsTemplateFocusTarget="True">
              <Grid Name="PART_FlyoutButtonContentGrid" Margin="{union:Style Layout.Padding}">
                <Border Name="PART_FirstPickerHost" Grid.Column="0">
                  <TextBlock Name="PART_HourTextBlock" Text="{DynamicResource StringTimePickerHourText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle Name="PART_FirstColumnDivider" Fill="{DynamicResource Union.Active.View.Decoration.FrameBrush}" HorizontalAlignment="Center" Width="1" Grid.Column="1" />
                <Border Name="PART_SecondPickerHost" Grid.Column="2">
                  <TextBlock Name="PART_MinuteTextBlock" Text="{DynamicResource StringTimePickerMinuteText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle Name="PART_SecondColumnDivider" Fill="{DynamicResource Union.Active.View.Decoration.FrameBrush}" HorizontalAlignment="Center" Width="1" Grid.Column="3" />
                <Border Name="PART_ThirdPickerHost" Grid.Column="4">
                  <TextBlock Name="PART_SecondTextBlock" Text="{DynamicResource StringTimePickerSecondText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle Name="PART_ThirdColumnDivider" Fill="{DynamicResource Union.Active.View.Decoration.FrameBrush}" HorizontalAlignment="Center" Width="1" Grid.Column="5" />
                <Border Name="PART_FourthPickerHost" Grid.Column="6">
                  <TextBlock Name="PART_PeriodTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <Popup Name="PART_Popup" WindowManagerAddShadowHint="False" IsLightDismissEnabled="True" PlacementTarget="{TemplateBinding}" Placement="Bottom">
              <TimePickerPresenter Name="PART_PickerPresenter" />
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:hasnotime /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TimePickerPresenter}" TargetType="TimePickerPresenter">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="union:Union.Type" Value="popup" />
    <Setter Property="union:Union.Hints" Value="combobox" />
    <Setter Property="union:Union.StateSource" Value="None" />
    <Setter Property="Foreground" Value="{union:Style Text.Color}" />
    <Setter Property="Width" Value="242" />
    <Setter Property="MinWidth" Value="242" />
    <Setter Property="MaxHeight" Value="398" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <union:UnionBox Margin="{union:Style Layout.Inset}" />
          <Grid Name="ContentPanel" RowDefinitions="*,Auto" Margin="{union:Style Layout.Padding}" MaxHeight="398">
            <Grid Name="PART_PickerContainer">
              <Grid.Styles>
                <Style Selector="DateTimePickerPanel > ListBoxItem">
                  <Setter Property="Theme" Value="{StaticResource UnionTumblerText}" />
                </Style>
              </Grid.Styles>
              <Panel Name="PART_HourHost" Grid.Column="0" union:Union.Type="tumbler" union:Union.StateSource="None" Background="Transparent">
                <union:UnionBox />
                <Border Theme="{StaticResource UnionTumblerBand}" />
                <ScrollViewer Theme="{StaticResource UnionPlainScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_HourSelector" PanelType="Hour" ItemHeight="32" ShouldLoop="True" />
                </ScrollViewer>
                <RepeatButton Name="PART_HourUpButton" Theme="{StaticResource UnionTumblerUp}" />
                <RepeatButton Name="PART_HourDownButton" Theme="{StaticResource UnionTumblerDown}" />
              </Panel>
              <Panel Name="PART_MinuteHost" Grid.Column="2" union:Union.Type="tumbler" union:Union.StateSource="None" Background="Transparent">
                <union:UnionBox />
                <Border Theme="{StaticResource UnionTumblerBand}" />
                <ScrollViewer Theme="{StaticResource UnionPlainScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_MinuteSelector" PanelType="Minute" ItemHeight="32" ShouldLoop="True" />
                </ScrollViewer>
                <RepeatButton Name="PART_MinuteUpButton" Theme="{StaticResource UnionTumblerUp}" />
                <RepeatButton Name="PART_MinuteDownButton" Theme="{StaticResource UnionTumblerDown}" />
              </Panel>
              <Panel Name="PART_SecondHost" Grid.Column="4" union:Union.Type="tumbler" union:Union.StateSource="None" Background="Transparent">
                <union:UnionBox />
                <Border Theme="{StaticResource UnionTumblerBand}" />
                <ScrollViewer Theme="{StaticResource UnionPlainScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_SecondSelector" PanelType="Second" ItemHeight="32" ShouldLoop="True" />
                </ScrollViewer>
                <RepeatButton Name="PART_SecondUpButton" Theme="{StaticResource UnionTumblerUp}" />
                <RepeatButton Name="PART_SecondDownButton" Theme="{StaticResource UnionTumblerDown}" />
              </Panel>
              <Panel Name="PART_PeriodHost" Grid.Column="6" union:Union.Type="tumbler" union:Union.StateSource="None" Background="Transparent">
                <union:UnionBox />
                <Border Theme="{StaticResource UnionTumblerBand}" />
                <ScrollViewer Theme="{StaticResource UnionPlainScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_PeriodSelector" PanelType="TimePeriod" ItemHeight="32" ShouldLoop="False" />
                </ScrollViewer>
                <RepeatButton Name="PART_PeriodUpButton" Theme="{StaticResource UnionTumblerUp}" />
                <RepeatButton Name="PART_PeriodDownButton" Theme="{StaticResource UnionTumblerDown}" />
              </Panel>
              <Rectangle Name="PART_FirstSpacer" Fill="{DynamicResource Union.Active.View.Decoration.FrameBrush}" HorizontalAlignment="Center" Width="1" Grid.Column="1" />
              <Rectangle Name="PART_SecondSpacer" Fill="{DynamicResource Union.Active.View.Decoration.FrameBrush}" HorizontalAlignment="Center" Width="1" Grid.Column="3" />
              <Rectangle Name="PART_ThirdSpacer" Fill="{DynamicResource Union.Active.View.Decoration.FrameBrush}" HorizontalAlignment="Center" Width="1" Grid.Column="5" />
            </Grid>
            <Grid Name="AcceptDismissGrid" Grid.Row="1" ColumnDefinitions="*,*" Margin="{union:Style Layout.Spacing, Sides=Top}">
              <Button Name="PART_AcceptButton" Grid.Column="0" Theme="{StaticResource UnionToolButton}" HorizontalAlignment="Stretch">
                <union:UnionIcon IconName="dialog-ok-apply" Width="16" Height="16" />
              </Button>
              <Button Name="PART_DismissButton" Grid.Column="1" Theme="{StaticResource UnionToolButton}" HorizontalAlignment="Stretch">
                <union:UnionIcon IconName="dialog-cancel" Width="16" Height="16" />
              </Button>
            </Grid>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Panel:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
