<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
    <Setter Property="union:Union.Type" Value="splitview" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="PreviewContent">
      <Template>
        <Rectangle Fill="{DynamicResource Union.Active.Selection.Background.NormalBrush}" />
      </Template>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <union:UnionBox Name="PART_Handle"
                          union:Union.Type="handle"
                          union:Union.StateSource="TemplatedParent"
                          ImplicitSize="True" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ union|UnionBox#PART_Handle">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="^.vertical /template/ union|UnionBox#PART_Handle">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
