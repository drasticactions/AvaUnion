<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="union:Union.Type" Value="toolseparator" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <union:UnionBox ImplicitSize="True" Margin="{union:Style Layout.Inset}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
