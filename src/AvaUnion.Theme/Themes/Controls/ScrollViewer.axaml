<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:union="https://github.com/avaunion"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer" BasedOn="{StaticResource UnionPlainScrollViewer}">
    <Setter Property="union:Union.Type" Value="scrollview" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <union:UnionBox Margin="{union:Style Layout.Inset}" />
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" Margin="{union:Style Border}">
            <ScrollContentPresenter Name="PART_ContentPresenter"
                                    Background="{TemplateBinding Background}"
                                    HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                    VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                    HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                    VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                    Padding="{TemplateBinding Padding}"
                                    ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}" />
            <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" Grid.Row="1" />
            <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Grid.Column="1" />
            <union:UnionBox Name="PART_ScrollAreaCorner"
                            Grid.Row="1"
                            Grid.Column="1"
                            union:Union.Type="scrollareacorner"
                            union:Union.StateSource="None">
              <union:UnionBox.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="IsVisible" ElementName="PART_HorizontalScrollBar" />
                  <Binding Path="IsVisible" ElementName="PART_VerticalScrollBar" />
                </MultiBinding>
              </union:UnionBox.IsVisible>
            </union:UnionBox>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
