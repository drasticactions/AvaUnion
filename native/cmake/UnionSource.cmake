set(UNION_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../external/union" CACHE PATH "The Union source tree")

if(NOT EXISTS "${UNION_SOURCE_DIR}/src/properties/StylePropertyGroup.h")
    message(FATAL_ERROR "UNION_SOURCE_DIR=${UNION_SOURCE_DIR} is not a Union source tree; run git submodule update --init")
endif()

file(STRINGS "${UNION_SOURCE_DIR}/CMakeLists.txt" _avu_union_version REGEX "^set\\(PROJECT_VERSION " LIMIT_COUNT 1)
string(REGEX MATCH "\"([0-9.]+)\"" _avu_match "${_avu_union_version}")
set(AVU_UNION_VERSION ${CMAKE_MATCH_1})
if(NOT AVU_UNION_VERSION)
    message(FATAL_ERROR "no PROJECT_VERSION in ${UNION_SOURCE_DIR}/CMakeLists.txt")
endif()

file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../src/avu_resolved.g.h" _avu_generated REGEX "sha256=[0-9a-f]+" LIMIT_COUNT 1)
string(REGEX MATCH "sha256=([0-9a-f]+)" _avu_match "${_avu_generated}")
set(_avu_generated_hash ${CMAKE_MATCH_1})
file(SHA256 "${UNION_SOURCE_DIR}/tools/propertygenerator/properties.yml" _avu_source_hash)
if(NOT _avu_source_hash STREQUAL _avu_generated_hash)
    message(FATAL_ERROR "Union's properties.yml at ${UNION_SOURCE_DIR} (${_avu_source_hash}) differs from the one the generated code was made from (${_avu_generated_hash}); regenerate with tools/union-properties")
endif()

macro(avu_union_private_includes)
set(AVU_UNION_PRIVATE_INCLUDE ${CMAKE_BINARY_DIR}/union-private-include)
file(MAKE_DIRECTORY ${AVU_UNION_PRIVATE_INCLUDE})
get_target_property(_union_includes Union::Union INTERFACE_INCLUDE_DIRECTORIES)
foreach(_dir ${_union_includes})
    foreach(_h union_export.h union_logging.h)
        if(EXISTS "${_dir}/Union/${_h}")
            configure_file("${_dir}/Union/${_h}" "${AVU_UNION_PRIVATE_INCLUDE}/${_h}" COPYONLY)
        endif()
    endforeach()
endforeach()

set(AVU_UNION_INCLUDE_DIRS "${UNION_SOURCE_DIR}/src" "${AVU_UNION_PRIVATE_INCLUDE}")
endmacro()
